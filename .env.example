# QR-Drop Environment Configuration Example

# API Application Settings
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional Discord Webhook for notifications / audit alerts
DISCORD_WEBHOOK_URL=

# PostgreSQL Database Configuration
# Local Docker defaults:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qrdrop
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=10
# Cloud deployment (e.g., Railway / Supabase / Neon):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Object Storage Configuration (Local MinIO or Cloudflare R2 / AWS S3)
# Local Docker MinIO:
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=qrdrop-blobs
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# Cloudflare R2 Free Cloud Alternative (10 GB free forever, $0 egress):
# MINIO_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# MINIO_ROOT_USER=<r2_access_key_id>
# MINIO_ROOT_PASSWORD=<r2_secret_access_key>
# MINIO_BUCKET=qrdrop-blobs
# MINIO_REGION=auto
# MINIO_USE_SSL=true
